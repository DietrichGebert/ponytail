# Use a separate LOCAL database. Existing .env is intentionally not overwritten.
DATABASE_URL=postgresql://vision:local-development-only@localhost:5432/vision_estates
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000,http://127.0.0.1:3100
WORKERS_ENABLED=false
# Required for staff login/invitations: at least 32 cryptographically random characters.
# Keep stable in a secret manager; rotation invalidates JWTs and unused invitation links.
AUTH_JWT_SECRET=
# The following URLs are integration GATEWAYS, not vendor endpoints.
# See docs/INTEGRATIONS.md. Leave empty until adapters are implemented and validated.
VALUATION_GATEWAY_URL=
VALUATION_GATEWAY_KEY=
CALENDAR_GATEWAY_URL=
CALENDAR_GATEWAY_KEY=
EMAIL_GATEWAY_URL=
EMAIL_GATEWAY_KEY=
BROKER_NOTIFICATION_EMAIL=
# Set only while creating the first administrator; remove immediately afterwards.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=


# Production API documentation opt-in (development docs are enabled).
API_DOCS_ENABLED=false

# Separate newsletter delivery credentials; pending subscriptions never imply delivery.
NEWSLETTER_EMAIL_GATEWAY_URL=
NEWSLETTER_EMAIL_GATEWAY_KEY=
# At least 32 random characters; keep stable in a secret manager. Rotation invalidates old links.
NEWSLETTER_TOKEN_SECRET=
PUBLIC_APP_URL=
# Full-tier strategy gateway. Its JSON must contain buyerPositioning, salesRoute and strategy.
AI_REPORT_GATEWAY_URL=
AI_REPORT_GATEWAY_KEY=
