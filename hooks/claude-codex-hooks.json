{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const r=[process.env.CLAUDE_PLUGIN_ROOT,process.env.PLUGIN_ROOT].find(Boolean);if(!r)throw Error('Plugin root is missing');require(require('path').join(r.split(String.fromCharCode(92)).join('/'), 'hooks/ponytail-activate.js'))\"",
            "timeout": 15,
            "statusMessage": "Loading ponytail mode..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const r=[process.env.CLAUDE_PLUGIN_ROOT,process.env.PLUGIN_ROOT].find(Boolean);if(!r)throw Error('Plugin root is missing');require(require('path').join(r.split(String.fromCharCode(92)).join('/'), 'hooks/ponytail-subagent.js'))\"",
            "timeout": 15,
            "statusMessage": "Loading ponytail mode..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const r=[process.env.CLAUDE_PLUGIN_ROOT,process.env.PLUGIN_ROOT].find(Boolean);if(!r)throw Error('Plugin root is missing');require(require('path').join(r.split(String.fromCharCode(92)).join('/'), 'hooks/ponytail-mode-tracker.js'))\"",
            "timeout": 15,
            "statusMessage": "Tracking ponytail mode..."
          }
        ]
      }
    ]
  }
}
